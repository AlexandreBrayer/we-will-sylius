{# Tableau de bord : point d'entrée unique du back-office Yack. Chaque métier y trouve sa porte
   (pages du site, produits et prix, catalogue, clients, commandes) ; le builder et le site s'ouvrent
   dans un autre onglet, avec la session de l'administrateur. Cartes de la maquette « Admin Sylius » : pastille d'icône,
   titre suivi d'un chevron, description en gris. #}
{% set shortcuts = [
    {label: 'Pages du site', text: 'Accueil, pages de contenu, FAQ : le builder, aux couleurs de la marque.', icon: 'tabler:layout-grid', href: path('app_yack_admin_builder'), external: true},
    {label: 'Gabarits des fiches', text: 'Mise en page des fiches produit et des pages catégorie.', icon: 'tabler:template', href: path('app_yack_admin_cms_template_index')},
    {label: 'Produits et prix', text: 'Fiches, prix, stock, photos et documents.', icon: 'tabler:tag', href: path('sylius_admin_product_index')},
    {label: 'Catalogue', text: 'Catégories et marques du menu de la boutique.', icon: 'tabler:book', href: path('sylius_admin_taxon_create')},
    {label: 'Clients et accès', text: 'Comptes PRO et ECOM, demandes d\'ouverture à la commande.', icon: 'tabler:user-shield', href: path('app_yack_admin_order_access_request_index')},
    {label: 'Commandes', text: 'Suivi, paiement, expédition.', icon: 'tabler:shopping-cart', href: path('sylius_admin_order_index')},
] %}
<div class="container-xl mb-4" data-test-yack-shortcuts>
<div class="row row-cards">
    {% for shortcut in shortcuts %}
        <div class="col-12 col-md-6 col-xl-4">
            <a class="card card-link yack-shortcut h-100 text-reset text-decoration-none"
               href="{{ shortcut.href }}"{% if shortcut.external ?? false %} target="_blank" rel="noopener"{% endif %}
               data-test-yack-shortcut="{{ loop.index }}">
                <span class="yack-shortcut__icon">{{ ux_icon(shortcut.icon) }}</span>
                <span class="yack-shortcut__body">
                    <span class="yack-shortcut__title">{{ shortcut.label }}{{ ux_icon('tabler:chevron-right') }}</span>
                    <span class="yack-shortcut__text">{{ shortcut.text }}</span>
                </span>
            </a>
        </div>
    {% endfor %}
</div>
</div>
