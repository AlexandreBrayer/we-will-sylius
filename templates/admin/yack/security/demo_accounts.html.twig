{# Comptes de démonstration sous le formulaire de connexion du back-office : seulement si YACK_DEMO_BAR=1, jamais en production.
   Un compte par niveau dans le builder (fixtures : yack_builder_level). Le bloc est dans le formulaire : un clic sur un compte
   remplit l'identifiant et le mot de passe (assets/admin/scripts/demo-login.js), sans envoyer le formulaire. #}
{% if yack_demo_bar %}
    <div class="yack-demo-login" role="group" aria-labelledby="yack-demo-login-title" data-yack-demo-password="yack" data-test-demo-admin-account>
        <p class="yack-demo-login__title" id="yack-demo-login-title">Démonstration : mot de passe <code>yack</code> pour les deux comptes</p>
        {% for account in [{email: 'admin@yack.test', level: 'libre', label: 'Administrateur, builder Libre'}, {email: 'editeur@yack.test', level: 'charte', label: 'Éditeur, builder Charte'}] %}
            <button type="button" class="yack-demo-login__account" data-yack-demo-login="{{ account.email }}" data-test-demo-account="{{ account.email }}" data-test-builder-level="{{ account.level }}">
                <span>{{ account.label }}</span>
                <span class="yack-demo-login__email">{{ account.email }}</span>
            </button>
        {% endfor %}
    </div>
{% endif %}
