{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}Demandes d'accès à la commande | {{ parent() }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}
    {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}
    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}
        <div class="page-header">
            <div class="container-xl">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="{{ path('sylius_admin_dashboard') }}">Tableau de bord</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_yack_admin_order_access_request_index') }}">Demandes d'accès à la commande</a></li>
                    {% block breadcrumb %}{% endblock %}
                </ol>
                <h1 class="page-title">{% block page_title %}{% endblock %}</h1>
            </div>
        </div>
        <div class="page-body">
            <div class="container-xl">
                {% block page_content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}

{% macro status_badge(status) %}
    {% set colors = {pending: 'bg-warning text-dark', accepted: 'bg-success text-white', refused: 'bg-secondary text-white'} %}
    <span class="badge {{ colors[status.value] }}" data-test-yack-request-status="{{ status.value }}">{{ status.label() }}</span>
{% endmacro %}
