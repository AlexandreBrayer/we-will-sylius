{# Onglets « SAV et pièces » et « Clients et encours » du tableau de bord (App\Yack\Steering\Infrastructure\Controller\Admin\SteeringController) :
   même en-tête que le tableau de bord de Sylius (titre « Tableau de bord », onglets), puis la pastille « Option, à chiffrer sur demande »
   et une ligne d'intro. #}
{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ page.label }} | {{ 'sylius.ui.dashboard'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}
    {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}
    <div class="page-wrapper" data-test-yack-steering="{{ page.value }}">
        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}
        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                <div class="row mt-3 row-gap-2">
                    <div class="col-12 col-md">
                        <h1 class="page-title">{{ 'sylius.ui.dashboard'|trans }}</h1>
                    </div>
                </div>
                {% include 'admin/yack/steering/_tabs.html.twig' with {active: page.value} %}
            </div>
        </div>
        <div class="page-body">
            <div class="container-xl">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                    {% include 'admin/yack/steering/_option.html.twig' %}
                    <span class="text-secondary">{% block intro %}{% endblock %}</span>
                </div>
                {% block page_content %}{% endblock %}
                <p class="text-secondary small mt-2 mb-0" data-test-yack-steering-source>{% block source %}{% endblock %}</p>
            </div>
        </div>
    </div>
{% endblock %}
