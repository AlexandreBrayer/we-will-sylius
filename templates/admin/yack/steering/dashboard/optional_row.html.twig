{# Tableau de bord, onglet Pilotage (hook sylius_admin.dashboard.index.content, entre le graphique Ventes et les blocs du bas) : rangée
   optionnelle Alertes, CA par gamme, Comment les clients paient (App\Yack\Steering\Application\PilotageReport), pour les comptes
   autorisés par SteeringVoter. Composants et classes du montage validé (bloc2.html). #}
{% if is_granted('YACK_STEERING') %}
{% import 'admin/yack/steering/_macros.html.twig' as steering %}
{% set report = yack_steering_pilotage() %}
{% set snapshot = report.snapshot %}
<div class="container-xl mb-4" data-test-yack-steering-optional>
    <div class="d-flex align-items-center gap-3 mb-3">
        <h2 class="m-0">Pilotage</h2>
        {% include 'admin/yack/steering/_option.html.twig' %}
    </div>
    <div class="row row-cards">
        <div class="col-12 col-lg-4">
            <div class="card h-100" data-test-yack-steering-alerts>
                <div class="card-header"><h2 class="card-title">Alertes</h2></div>
                <div class="list-group list-group-flush">
                    {% for group in snapshot.alerts.bySeverity %}
                        <div class="list-group-header fs-5 fw-bold text-secondary lh-base">{{ group.severity.label }}</div>
                        {% for alert in group.alerts %}
                            {% set dot = {critique: 'bg-red', a_surveiller: 'bg-warning', pour_info: 'bg-azure'}[group.severity.value] %}
                            <a href="{{ steering.alert_href(alert, snapshot)|trim }}" class="list-group-item list-group-item-action d-flex gap-2" data-test-yack-steering-alert="{{ alert.kind.value }}">
                                <span class="badge {{ dot }} yack-alert-dot mt-1" aria-hidden="true"></span>
                                <span>
                                    <span class="fw-medium">{{ alert.title }}</span><br>
                                    <span class="text-secondary small">{{ alert.detail }}</span>
                                </span>
                            </a>
                        {% endfor %}
                    {% else %}
                        <div class="list-group-item text-secondary">Aucune alerte en ce moment.</div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card h-100" data-test-yack-steering-ranges>
                <div class="card-header">
                    <h2 class="card-title">CA par gamme</h2>
                    <span class="ms-auto text-secondary small">30 jours</span>
                </div>
                <div class="card-body">
                    {% for range in report.ranges %}
                        <div class="d-flex justify-content-between mb-1"><span>{{ range.name }}</span><strong>{{ range.amount|yack_short_euros }}</strong></div>
                        <div class="progress progress-sm{{ loop.last ? '' : ' mb-3' }}" role="presentation"><div class="progress-bar" style="width: {{ range.share }}%"></div></div>
                    {% else %}
                        <p class="text-secondary m-0">Aucune commande sur les 30 derniers jours.</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card h-100" data-test-yack-steering-payments>
                <div class="card-header">
                    <h2 class="card-title">Comment les clients paient</h2>
                    <span class="ms-auto text-secondary small">30 jours</span>
                </div>
                <div class="card-body">
                    {% set colors = ['bg-primary', 'bg-azure', 'bg-teal', 'bg-yellow'] %}
                    {% if report.methods is not empty %}
                        <div class="progress progress-separated yack-payment-split mb-3" role="presentation">
                            {% for method in report.methods %}<div class="progress-bar {{ colors[loop.index0 % 4] }}" style="width: {{ method.share }}%"></div>{% endfor %}
                        </div>
                    {% endif %}
                    {% for method in report.methods %}
                        <div class="d-flex align-items-center mb-2">
                            <span class="legend {{ colors[loop.index0 % 4] }} me-2"></span>{{ method.name }}
                            <span class="ms-auto text-secondary small me-3">{{ method.amount|yack_short_euros }}</span>
                            <strong>{{ method.share }}&nbsp;%</strong>
                        </div>
                    {% endfor %}
                    {% set discounted = report.methods|filter(m => m.rate is not null and m.rate > 0) %}
                    <hr class="my-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Escompte accordé{% if discounted is not empty %} ({% for m in discounted %}{{ m.rate|number_format(m.rate == m.rate|round ? 0 : 1, ',') }}&nbsp;% {{ m.name|lower }}{{ loop.last ? '' : ', ' }}{% endfor %}){% endif %}</span>
                        <strong>{{ report.escompte|yack_euros }}</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary">Échéances pas encore réglées</span>
                        <strong>{{ snapshot.receivablesTotal|yack_short_euros }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <p class="text-secondary small mt-2 mb-0" data-test-yack-steering-source>CA : montant HT des marchandises (remises et escompte déduits, port exclu) des commandes passées sur la période, hors commandes annulées ; le graphique « Ventes » compte les commandes payées, TTC. Escompte : taux de chaque moyen de paiement (configuration Yack), montant réellement accordé sur les commandes. Garanties : dates simulées.</p>
</div>
{% endif %}
