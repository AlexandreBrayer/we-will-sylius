{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Commander en ligne | {{ parent() }}{% endblock %}

{% block content %}
<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('sylius_shop_homepage') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('sylius_shop_account_dashboard') }}">Mon compte</a></li>
            <li class="breadcrumb-item active" aria-current="page">Commander en ligne</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-4">
            <h1 class="mb-3">Commander en ligne</h1>
            <p class="lead">Passez vos commandes Clik&amp;Yack directement sur le site, 24 h/24.</p>
            <ul class="list-unstyled text-body-secondary">
                <li class="mb-2">✓ Prix et disponibilités en temps réel</li>
                <li class="mb-2">✓ Pièces détachées commandables depuis le n° de série</li>
                <li class="mb-2">✓ Escompte en payant par carte ou par virement sous 15 jours</li>
                <li class="mb-2">✓ Suivi de vos commandes dans votre espace client</li>
            </ul>
        </div>

        <div class="col-lg-8">
            {% if pending_request %}
                <div class="card border-warning" data-test-yack-order-access="pending">
                    <div class="card-body p-4">
                        <span class="badge text-bg-warning mb-3">Demande en cours</span>
                        <h2 class="h4">Votre demande est en cours de traitement</h2>
                        <p class="mb-3">Envoyée le {{ pending_request.createdAt|date('d/m/Y à H:i') }} pour <strong>{{ pending_request.company }}</strong> (SIRET {{ pending_request.siret }}).</p>
                        <p class="text-body-secondary mb-0">Votre agence Yack vérifie votre dossier et vous confirme l'ouverture à la commande par e-mail à {{ pending_request.email }}. Dès l'acceptation, les prix et le panier apparaissent sur votre compte.</p>
                    </div>
                </div>
            {% else %}
                {% if refused_request and refused_request.status.value == 'refused' %}
                    <div class="alert alert-secondary" data-test-yack-order-access="refused">
                        Votre précédente demande du {{ refused_request.createdAt|date('d/m/Y') }} n'a pas été acceptée. Vous pouvez en déposer une nouvelle ou contacter votre agence Yack.
                    </div>
                {% endif %}

                <div class="card" data-test-yack-order-access="form">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-1">Demandez l'ouverture de votre compte à la commande</h2>
                        <p class="text-body-secondary">Les informations de votre compte sont pré-remplies : vérifiez-les et complétez l'adresse.</p>

                        {{ form_start(form) }}
                            <div class="row g-3">
                                <div class="col-md-7">{{ form_row(form.company) }}</div>
                                <div class="col-md-5">{{ form_row(form.siret) }}</div>
                                <div class="col-md-12">{{ form_row(form.fullName) }}</div>
                                <div class="col-md-7">{{ form_row(form.email) }}</div>
                                <div class="col-md-5">{{ form_row(form.phone) }}</div>
                                <div class="col-md-12">{{ form_row(form.address) }}</div>
                                <div class="col-md-12">{{ form_row(form.message) }}</div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg mt-3" data-test-yack-order-access-submit>Envoyer ma demande</button>
                        {{ form_end(form) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
