{# Tableau de bord du compte client : profil Yack, société, accès commande, raccourcis #}
{% set customer = hookable_metadata.context.customer %}
{% set profile = yack_customer_profile() %}

<div class="card yack-account-card my-4" data-test-yack-account-dashboard="{{ profile.value }}">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="badge bg-yack">{{ profile.label }}</span>
            {% if is_granted('YACK_PLACE_ORDER') %}
                <span class="badge text-bg-success">Commande en ligne ouverte</span>
            {% endif %}
        </div>

        <dl class="row mb-0">
            {% if customer.company %}
                <dt class="col-sm-4 text-body-secondary fw-normal">Société</dt>
                <dd class="col-sm-8 fw-semibold" data-test-yack-account-company>{{ customer.company }}</dd>
            {% endif %}
            {% if customer.siret %}
                <dt class="col-sm-4 text-body-secondary fw-normal">SIRET</dt>
                <dd class="col-sm-8">{{ customer.siret }}</dd>
            {% endif %}
            {% if customer.vatNumber %}
                <dt class="col-sm-4 text-body-secondary fw-normal">N° TVA intracom.</dt>
                <dd class="col-sm-8">{{ customer.vatNumber }}</dd>
            {% endif %}
            {% if customer.phoneNumber %}
                <dt class="col-sm-4 text-body-secondary fw-normal">Téléphone</dt>
                <dd class="col-sm-8">{{ customer.phoneNumber }}</dd>
            {% endif %}
            {% if customer.defaultAddress %}
                {% set address = customer.defaultAddress %}
                <dt class="col-sm-4 text-body-secondary fw-normal">Adresse de facturation</dt>
                <dd class="col-sm-8">{{ address.street }}, {{ address.postcode }} {{ address.city }}</dd>
            {% endif %}
        </dl>

        {% if is_granted('YACK_REQUEST_ORDER_ACCESS') %}
            {% set access_request = yack_order_access_request() %}
            <hr>
            {% if access_request and access_request.pending %}
                <div class="alert alert-warning mb-0" data-test-yack-order-access-cta="pending">
                    <strong>Demande d'ouverture à la commande en cours</strong> — envoyée le {{ access_request.createdAt|date('d/m/Y') }}.
                    <a href="{{ path('app_yack_order_access_request') }}">Suivre ma demande</a>
                </div>
            {% else %}
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3" data-test-yack-order-access-cta="open">
                    <div>
                        <div class="fw-bold">Commander en ligne</div>
                        <div class="text-body-secondary">Prix, disponibilités et commande directe : demandez l'ouverture de votre compte.</div>
                    </div>
                    <a class="btn btn-primary" href="{{ path('app_yack_order_access_request') }}">Demander l'ouverture à la commande</a>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <a class="card h-100 text-decoration-none yack-account-shortcut" href="{{ path('sylius_shop_account_order_index') }}">
            <div class="card-body"><div class="fw-bold">Mes commandes</div><div class="small text-body-secondary">Suivi, paiement, livraison</div></div>
        </a>
    </div>
    <div class="col-sm-4">
        <a class="card h-100 text-decoration-none yack-account-shortcut" href="{{ path('sylius_shop_account_address_book_index') }}">
            <div class="card-body"><div class="fw-bold">Mes adresses</div><div class="small text-body-secondary">Facturation et livraison</div></div>
        </a>
    </div>
    <div class="col-sm-4">
        <a class="card h-100 text-decoration-none yack-account-shortcut" href="{{ path('app_yack_sav_index') }}">
            <div class="card-body"><div class="fw-bold">SAV &amp; pièces</div><div class="small text-body-secondary">Recherche par n° de série</div></div>
        </a>
    </div>
</div>
