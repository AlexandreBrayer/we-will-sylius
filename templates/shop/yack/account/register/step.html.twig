{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Créer un compte — {{ step.label }} | {{ parent() }}{% endblock %}

{% block content %}
<div class="container py-5" data-test-yack-register="{{ step.value }}">
    <div class="text-center mb-4">
        <h1 class="mb-2">Créer votre compte Clik&amp;Yack</h1>
        <p class="text-body-secondary mb-0">Déjà client ? <a href="{{ path('sylius_shop_login') }}">Connectez-vous</a></p>
    </div>

    {% set progress_steps = [] %}
    {% for s in steps %}
        {% set progress_steps = progress_steps|merge([{ name: s.value, label: s.label, route: 'sylius_shop_register', params: { step: s.value } }]) %}
    {% endfor %}
    {% include 'shop/yack/layout/_progress.html.twig' with {
        steps: progress_steps,
        active_index: step.position,
        aria_label: 'Étapes de l\'inscription',
    } %}

    <div class="card yack-register-card shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <h2 class="h4 mb-4">Étape {{ step.position }} sur {{ steps|length }} — {{ step.label }}</h2>

            {% form_theme form '@SyliusShop/form/theme.html.twig' %}
            {{ form_start(form, { attr: { novalidate: 'novalidate', 'data-test-register-form': step.value } }) }}
            {{ form_errors(form) }}

            {% if step.value == 'profil' %}
                <div class="row g-3 mb-2" role="radiogroup">
                    {% for choice in form.profile %}
                        <div class="col-md-6">
                            {{ form_widget(choice, { attr: { class: 'btn-check' } }) }}
                            <label for="{{ choice.vars.id }}" class="yack-profile-choice card h-100 border p-4">
                                {% if choice.vars.value == 'pro' %}
                                    <span class="h5 mb-2">Professionnel (PRO)</span>
                                    <span class="text-body-secondary">Installateur, chauffagiste, frigoriste… Accès au SAV et aux pièces par n° de série ; ouverture à la commande en ligne sur demande.</span>
                                {% else %}
                                    <span class="h5 mb-2">Client e-commerce (ECOM)</span>
                                    <span class="text-body-secondary">Commande en ligne avec prix et disponibilités dès l'activation du compte.</span>
                                {% endif %}
                            </label>
                        </div>
                    {% endfor %}
                </div>
                {% do form.profile.setRendered %}
                {% for error in form.profile.vars.errors %}<div class="invalid-feedback d-block">{{ error.message }}</div>{% endfor %}
            {% elseif step.value == 'societe' %}
                {% if not registration.pro %}
                    <p class="text-body-secondary">Compte e-commerce : renseignez votre société si vous commandez pour une entreprise (facultatif).</p>
                {% endif %}
                <div class="row g-3">
                    <div class="col-md-12">{{ form_row(form.company) }}</div>
                    <div class="col-md-6">{{ form_row(form.siret) }}</div>
                    <div class="col-md-6">{{ form_row(form.vatNumber) }}</div>
                </div>
            {% elseif step.value == 'contact' %}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                    <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                    <div class="col-md-7">{{ form_row(form.email) }}</div>
                    <div class="col-md-5">{{ form_row(form.phoneNumber) }}</div>
                    <div class="col-md-6">{{ form_row(form.plainPassword.first) }}</div>
                    <div class="col-md-6">{{ form_row(form.plainPassword.second) }}</div>
                </div>
                {{ form_errors(form.plainPassword) }}
            {% else %}
                <h3 class="h6 text-uppercase text-body-secondary mb-3">Adresse de facturation</h3>
                <div class="row g-3 mb-3">
                    <div class="col-md-12">{{ form_row(form.billingStreet) }}</div>
                    <div class="col-md-3">{{ form_row(form.billingPostcode) }}</div>
                    <div class="col-md-5">{{ form_row(form.billingCity) }}</div>
                    <div class="col-md-4">{{ form_row(form.billingCountryCode) }}</div>
                </div>
                {{ form_row(form.shippingSameAsBilling, { attr: { 'data-yack-toggle': 'yack-shipping-address' } }) }}
                <fieldset id="yack-shipping-address" class="mt-3" {% if registration.shippingSameAsBilling %}hidden{% endif %}>
                    <h3 class="h6 text-uppercase text-body-secondary mb-3">Adresse de livraison</h3>
                    <div class="row g-3">
                        <div class="col-md-12">{{ form_row(form.shippingStreet) }}</div>
                        <div class="col-md-3">{{ form_row(form.shippingPostcode) }}</div>
                        <div class="col-md-5">{{ form_row(form.shippingCity) }}</div>
                        <div class="col-md-4">{{ form_row(form.shippingCountryCode) }}</div>
                    </div>
                </fieldset>
                <script>
                    document.querySelectorAll('[data-yack-toggle]').forEach((checkbox) => {
                        const target = document.getElementById(checkbox.dataset.yackToggle);
                        checkbox.addEventListener('change', () => { target.hidden = checkbox.checked; });
                    });
                </script>
            {% endif %}

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                {% if step.previous %}
                    <a class="btn btn-link px-0" href="{{ path('sylius_shop_register', { step: step.previous.value }) }}">‹ Étape précédente</a>
                {% else %}
                    <span></span>
                {% endif %}
                <button type="submit" class="btn btn-primary px-4" data-test-register-next>
                    {{ step.next ? 'Continuer' : 'Créer mon compte' }}
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
