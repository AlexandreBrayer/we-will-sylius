{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Compte créé | {{ parent() }}{% endblock %}

{% block content %}
<div class="container py-5" data-test-yack-register="done">
    {% include 'shop/yack/layout/_progress.html.twig' with {
        steps: [{ label: 'Profil' }, { label: 'Société' }, { label: 'Contact' }, { label: 'Adresses' }, { label: 'Activation' }],
        active_index: 5,
        links_enabled: false,
        aria_label: 'Étapes de l\'inscription',
    } %}

    <div class="card yack-auth-card shadow-sm">
        <div class="card-body p-4 p-lg-5 text-center">
            <div class="display-6 mb-3" aria-hidden="true">✉</div>
            <h1 class="h3 mb-3">Votre compte est créé</h1>
            <p>Un e-mail d'activation a été envoyé à <strong>{{ email }}</strong>.<br>Cliquez sur le lien qu'il contient pour activer votre compte, puis connectez-vous.</p>
            {% if pro %}
                <p class="text-body-secondary">Compte professionnel : vous aurez accès au SAV et aux pièces détachées. Pour commander en ligne, faites une demande depuis votre espace client.</p>
            {% endif %}
            <p class="small text-body-secondary mb-4">Rien reçu ? Vérifiez vos courriers indésirables.</p>
            <a href="{{ path('sylius_shop_login') }}" class="btn btn-primary">Aller à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
