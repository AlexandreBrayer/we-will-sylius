{% if not is_granted('YACK_SEE_PRICES') %}
    {% if is_granted('YACK_REQUEST_ORDER_ACCESS') %}
        {% set access_request = yack_order_access_request() %}
        <div class="small mt-1" data-test-yack-pricing-notice="pro">
            {% if access_request and access_request.pending %}
                <span class="text-body-tertiary" data-test-yack-order-access-cta="pending">Demande d'ouverture à la commande en cours</span>
            {% else %}
                <a href="{{ path('app_yack_order_access_request') }}" class="link-primary" data-test-yack-order-access-cta="open">Commander en ligne : demandez l'ouverture de votre compte</a>
            {% endif %}
        </div>
    {% else %}
        <div class="small text-body-tertiary mt-1" data-test-yack-pricing-notice="{{ yack_customer_profile().value }}">
            Connectez-vous pour voir les prix
        </div>
    {% endif %}
{% endif %}
