{% if not is_granted('YACK_SEE_PRICES') %}
    {% set profile = yack_customer_profile() %}
    {% if is_granted('YACK_REQUEST_ORDER_ACCESS') %}
        {% set access_request = yack_order_access_request() %}
        {% if access_request and access_request.pending %}
            <div class="alert alert-warning my-4" role="note" data-test-yack-pricing-notice="pro" data-test-yack-order-access-cta="pending">
                <div class="fw-bold">Demande d'ouverture à la commande en cours</div>
                <div>Envoyée le {{ access_request.createdAt|date('d/m/Y') }} : les prix et le panier apparaîtront dès sa validation par Yack.
                    <a href="{{ path('app_yack_order_access_request') }}">Suivre ma demande</a></div>
            </div>
        {% else %}
            <div class="card border-primary my-4" data-test-yack-pricing-notice="pro" data-test-yack-order-access-cta="open">
                <div class="card-body">
                    <div class="fw-bold mb-1">Commander en ligne</div>
                    <p class="mb-3">Demandez l'ouverture de votre compte à la commande : prix, disponibilités et commande directe sur Clik&amp;Yack.</p>
                    <a class="btn btn-primary" href="{{ path('app_yack_order_access_request') }}">Demander l'ouverture à la commande</a>
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="alert alert-info my-4" role="note" data-test-yack-pricing-notice="{{ profile.value }}">
            <div class="fw-bold">Prix réservés aux clients connectés</div>
            <div>
                <a href="{{ path('sylius_shop_login') }}">Connectez-vous</a> ou
                <a href="{{ path('sylius_shop_register') }}">créez un compte</a> pour consulter les prix et commander en ligne.
            </div>
        </div>
    {% endif %}
{% endif %}
