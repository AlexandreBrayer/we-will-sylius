{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% set cart = hookable_metadata.context.cart %}
{% set escompte_type = constant('App\\OrderProcessing\\EscompteProcessor::ESCOMPTE_ADJUSTMENT') %}
{% set escompte_total = cart.adjustmentsTotalRecursively(escompte_type) %}

{% if escompte_total != 0 %}
    <div class="hstack gap-2 mb-2" data-test-escompte>
        <div>{{ cart.adjustmentsRecursively(escompte_type)|first.label }} <small class="text-body-tertiary">(sur le HT)</small> :</div>
        <div class="ms-auto text-end text-success">{{ money.convertAndFormat(escompte_total) }}</div>
    </div>
{% endif %}
