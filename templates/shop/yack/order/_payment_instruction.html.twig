{# Modalités de paiement d'une commande : RIB + référence + échéance (virement) ou paiement carte accepté. #}
{% import "@SyliusShop/shared/macro/money.html.twig" as money %}
{% set instruction = yack_payment_instruction(order) %}
{% set payment = order.lastPayment %}

{% if instruction is not null and instruction.bankTransfer %}
    <div class="yack-callout" data-test-payment-instruction="virement">
        {% if payment is not null and payment.state == 'completed' %}
            <p class="mb-0"><strong>Virement reçu</strong> — merci, votre règlement de {{ money.convertAndFormat(order.total) }} a été enregistré par Yack.</p>
        {% else %}
            <p class="mb-2"><strong>{{ payment.method.name }}</strong> — merci d'effectuer votre virement de <strong>{{ money.convertAndFormat(order.total) }}</strong> avant le <strong data-test-due-date>{{ instruction.dueDate|date('d/m/Y') }}</strong>.</p>
            <dl class="row yack-rib mb-0 small">
                <dt class="col-sm-4">Titulaire</dt><dd class="col-sm-8">{{ instruction.bankAccount.holder }}</dd>
                <dt class="col-sm-4">Banque</dt><dd class="col-sm-8">{{ instruction.bankAccount.bank }}</dd>
                <dt class="col-sm-4">IBAN</dt><dd class="col-sm-8" data-test-iban>{{ instruction.bankAccount.iban }}</dd>
                <dt class="col-sm-4">BIC</dt><dd class="col-sm-8">{{ instruction.bankAccount.bic }}</dd>
                <dt class="col-sm-4">Référence à indiquer</dt><dd class="col-sm-8"><strong data-test-payment-reference>{{ instruction.reference }}</strong></dd>
            </dl>
        {% endif %}
    </div>
{% elseif instruction is not null and instruction.card %}
    <div class="yack-callout yack-callout--success" data-test-payment-instruction="carte">
        <strong>Paiement accepté</strong> — {{ money.convertAndFormat(order.total) }} réglés par carte bancaire.
        <div class="small text-body-secondary">Simulation POC : aucune transaction réelle n'a été effectuée.</div>
    </div>
{% endif %}
