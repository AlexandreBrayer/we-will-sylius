{% set payment = hookable_metadata.context.order.lastPayment %}

{% if payment is not null and payment.method is not null %}
    <div class="row">
        <div class="col-12 col-sm-4">Paiement</div>
        <div class="col" data-test-order-payment-method>
            {{ payment.method.name }}
            {% set escompte = yack_payment_escompte_label(payment.method.code) %}
            {% if escompte %}<span class="badge text-bg-success ms-1">{{ escompte }}</span>{% endif %}
        </div>
    </div>
{% endif %}
