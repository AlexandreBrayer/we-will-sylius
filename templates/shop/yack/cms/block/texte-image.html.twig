<section class="yack-cms-section container" data-yack-block="texte-image">
    <div class="row align-items-center g-5">
        <div class="col-lg-6 {{ props.imagePosition == 'droite' ? 'order-lg-2' : '' }}">
            <div class="yack-cms-visual yack-cms-visual--light"><img src="{{ asset(props.image) }}" alt="" loading="lazy"></div>
        </div>
        <div class="col-lg-6">
            <h2 class="mb-3">{{ props.title }}</h2>
            <p class="yack-cms-text mb-4">{{ props.text }}</p>
            {% include 'shop/yack/cms/_cta.html.twig' with {label: props.ctaLabel, url: props.ctaUrl} only %}
        </div>
    </div>
</section>
