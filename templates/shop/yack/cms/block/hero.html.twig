<section class="yack-cms-section yack-cms-hero yack-cms-theme-{{ props.theme }}" data-yack-block="hero">
    <div class="container py-6">
        <div class="row align-items-center g-5">
            <div class="{{ props.image ? 'col-lg-7' : 'col-lg-9' }}">
                <h1 class="display-5 fw-bold">{{ props.title }}</h1>
                {% if props.subtitle %}<p class="lead mb-4">{{ props.subtitle }}</p>{% endif %}
                {% include 'shop/yack/cms/_cta.html.twig' with {label: props.ctaLabel, url: props.ctaUrl, class: props.theme == 'clair' ? 'btn-primary' : 'btn-light'} only %}
            </div>
            {% if props.image %}
                <div class="col-lg-5">
                    <div class="yack-cms-visual"><img src="{{ asset(props.image) }}" alt="" loading="lazy"></div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
