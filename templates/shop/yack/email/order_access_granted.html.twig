{% extends 'shop/yack/email/layout.html.twig' %}

{% block subject %}Votre compte est ouvert à la commande{% endblock %}

{% block content %}
    {% set customer = access_request.customer %}
    <h1 style="color: #A7357F; font-size: 22px; margin: 0 0 16px;">Votre compte est ouvert à la commande</h1>
    <p>Bonjour {{ customer.firstName|default(access_request.fullName) }},</p>
    <p>Yack a accepté votre demande d'ouverture à la commande pour <strong>{{ access_request.company }}</strong> (SIRET {{ access_request.siret }}).</p>
    <p>Dès votre prochaine connexion, vous voyez les prix et pouvez commander en ligne, avec un escompte de 2 % pour un règlement par virement sous 15 jours ou par carte.</p>
    {% include 'shop/yack/email/_button.html.twig' with {
        url: yack_front_url ~ '/produits',
        label: 'Commander sur Clik&Yack',
    } %}
{% endblock %}
