{% extends 'shop/yack/email/layout.html.twig' %}

{% block subject %}Votre commande n° {{ order.number }} a été expédiée{% endblock %}

{% block content %}
    <h1 style="color: #A7357F; font-size: 22px; margin: 0 0 16px;">Votre commande est en route</h1>
    <p>Bonjour {{ order.customer.firstName|default('') }},</p>
    <p>Votre commande <strong>n° {{ order.number }}</strong> a été expédiée ({{ shipment.method }}).</p>
    {% if shipment.tracking is not null %}
        <p style="background: #f8eef5; border-left: 4px solid #A7357F; padding: 12px 16px;">
            Numéro de suivi transporteur : <strong>{{ shipment.tracking }}</strong>
        </p>
    {% endif %}
    {% include 'shop/yack/email/_button.html.twig' with {
        url: url('sylius_shop_account_order_show', {'number': order.number, '_locale': order.localeCode|default('fr_FR')}),
        label: 'Suivre ma commande',
    } %}
{% endblock %}
