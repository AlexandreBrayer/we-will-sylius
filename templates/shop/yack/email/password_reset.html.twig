{% extends 'shop/yack/email/layout.html.twig' %}

{% block subject %}Réinitialisation de votre mot de passe Clik&Yack{% endblock %}

{% block content %}
    <h1 style="color: #A7357F; font-size: 22px; margin: 0 0 16px;">Mot de passe oublié ?</h1>
    <p>Bonjour {{ user.customer.firstName|default('') }},</p>
    <p>Une réinitialisation du mot de passe a été demandée pour le compte <strong>{{ user.email }}</strong>. Choisissez un nouveau mot de passe :</p>
    {% include 'shop/yack/email/_button.html.twig' with {
        url: url('sylius_shop_password_reset', {'token': user.passwordResetToken, '_locale': localeCode|default('fr_FR')}),
        label: 'Choisir un nouveau mot de passe',
    } %}
    <p style="color: #4d4d4f; font-size: 13px;">Ce lien est valable pour une durée limitée. Si vous n'avez rien demandé, ignorez ce message : votre mot de passe actuel reste valable.</p>
{% endblock %}
