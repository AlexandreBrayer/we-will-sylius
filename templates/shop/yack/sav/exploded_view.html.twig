{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% import '@SyliusShop/shared/macro/money.html.twig' as money %}

{% block title %}{{ exploded_view.name }} — {{ model.name }} | {{ parent() }}{% endblock %}

{% block content %}
{% set can_see_prices = is_granted('YACK_SEE_PRICES') %}
{% set can_order = is_granted('YACK_PLACE_ORDER') %}
<div class="container py-5" {{ stimulus_controller('exploded-view') }}>
    {% include 'shop/yack/sav/_breadcrumb.html.twig' %}

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="mb-1">{{ exploded_view.name }}</h1>
            <div class="text-body-secondary">{{ model.name }} · ServiceCode <code>{{ model.serviceCode }}</code></div>
        </div>
        {% if model.explodedViews|length > 1 %}
            <div class="btn-group" role="group" aria-label="Vues éclatées">
                {% for view in model.explodedViews %}
                    <a class="btn btn-sm {{ view.id == exploded_view.id ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ path('app_yack_sav_exploded_view', {serviceCode: model.serviceCode, explodedViewId: view.id, serial: serial}) }}">{{ view.name }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {% if not can_see_prices %}
        {% include 'shop/yack/account/product_pricing_notice.html.twig' %}
    {% endif %}

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="yack-exploded position-sticky" style="top: 1rem">
                <img class="img-fluid rounded-3 border" src="{{ asset(exploded_view.imagePath) }}" alt="{{ exploded_view.name }}">
                {% for item in exploded_view.items %}
                    <button type="button" class="yack-hotspot" style="left: {{ item.x }}%; top: {{ item.y }}%"
                        data-exploded-view-target="hotspot" data-marker="{{ item.marker }}"
                        data-action="mouseenter->exploded-view#highlight mouseleave->exploded-view#clear click->exploded-view#focus"
                        aria-label="Repère {{ item.marker }} : {{ item.part.name }}">{{ item.marker }}</button>
                {% endfor %}
            </div>
        </div>

        <div class="col-xl-7">
            <div class="table-responsive">
                <table class="table table-sm align-middle" data-test-yack-parts>
                    <thead>
                        <tr>
                            <th scope="col">Rep.</th>
                            <th scope="col">Pièce</th>
                            <th scope="col" class="text-center">Qté</th>
                            {% if can_see_prices %}<th scope="col" class="text-end">Prix HT</th>{% endif %}
                            <th scope="col">Dispo.</th>
                            {% if can_order %}<th scope="col"></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in exploded_view.items %}
                            {% set part = item.part %}
                            {% set variant = part.enabledVariants.first %}
                            {% set available = variant ? (variant.tracked ? variant.onHand - variant.onHold : 999) : 0 %}
                            <tr data-exploded-view-target="row" data-marker="{{ item.marker }}"
                                data-action="mouseenter->exploded-view#highlight mouseleave->exploded-view#clear">
                                <td><span class="yack-marker">{{ item.marker }}</span></td>
                                <td>
                                    <a href="{{ path('sylius_shop_product_show', {slug: part.slug}) }}" class="fw-bold text-decoration-none">{{ part.name }}</a>
                                    <div class="small text-body-secondary">Réf. {{ part.code }}</div>
                                </td>
                                <td class="text-center">{{ item.quantity }}</td>
                                {% if can_see_prices %}
                                    <td class="text-end text-nowrap" data-test-yack-part-price>{{ variant and part.enabled ? money.calculatePrice(variant) : '—' }}</td>
                                {% endif %}
                                <td class="text-nowrap">
                                    {% if not part.enabled %}
                                        <span class="badge text-bg-secondary">Plus commercialisée</span>
                                    {% elseif available > 0 %}
                                        <span class="badge text-bg-success">En stock ({{ available }})</span>
                                    {% else %}
                                        <span class="badge text-bg-warning">Sur commande</span>
                                    {% endif %}
                                </td>
                                {% if can_order %}
                                    <td class="text-end">
                                        {% if variant and part.enabled %}
                                            <form method="post" action="{{ path('app_yack_sav_add_to_cart', {serviceCode: model.serviceCode, explodedViewId: exploded_view.id, serial: serial}) }}" class="d-flex gap-1 justify-content-end">
                                                <input type="hidden" name="_token" value="{{ csrf_token('yack_sav_add_to_cart') }}">
                                                <input type="hidden" name="marker" value="{{ item.marker }}">
                                                <input type="number" name="quantity" value="1" min="1" max="99" class="form-control form-control-sm" style="width: 3.75rem" aria-label="Quantité">
                                                <button class="btn btn-sm btn-primary text-nowrap" type="submit" data-test-yack-add-part="{{ item.marker }}">Ajouter</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
