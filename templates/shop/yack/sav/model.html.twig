{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ model.name }} — SAV | {{ parent() }}{% endblock %}

{% block content %}
<div class="container py-5">
    {% include 'shop/yack/sav/_breadcrumb.html.twig' %}

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="mb-1">{{ model.name }}</h1>
            <div class="text-body-secondary">{{ model.family }} · ServiceCode <code>{{ model.serviceCode }}</code></div>
        </div>
        {% if model.finishedProduct %}
            <a class="btn btn-outline-secondary" href="{{ path('sylius_shop_product_show', {slug: model.finishedProduct.slug}) }}">Fiche produit</a>
        {% endif %}
    </div>

    <div class="row g-4" data-test-yack-exploded-views>
        {% for view in model.explodedViews %}
            <div class="col-md-6">
                <a class="card h-100 text-decoration-none" href="{{ path('app_yack_sav_exploded_view', {serviceCode: model.serviceCode, explodedViewId: view.id, serial: serial}) }}">
                    <img class="card-img-top bg-light" src="{{ asset(view.imagePath) }}" alt="{{ view.name }}">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-bold">{{ view.name }}</span>
                        <span class="badge text-bg-primary rounded-pill">{{ view.items|length }} pièces</span>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
