<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('sylius_shop_homepage') }}">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_yack_sav_index', serial ? {serial: serial} : {}) }}">SAV{% if serial %} — {{ serial }}{% endif %}</a></li>
        {% if model is defined and model %}
            <li class="breadcrumb-item{{ exploded_view is defined ? '' : ' active' }}">
                {% if exploded_view is defined %}<a href="{{ path('app_yack_sav_model', {serviceCode: model.serviceCode, serial: serial}) }}">{{ model.name }}</a>{% else %}{{ model.name }}{% endif %}
            </li>
        {% endif %}
        {% if exploded_view is defined %}
            <li class="breadcrumb-item active" aria-current="page">{{ exploded_view.name }}</li>
        {% endif %}
    </ol>
</nav>
