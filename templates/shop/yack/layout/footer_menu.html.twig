{# Pied de page : pages CMS publiées (builder cms/) + services Yack #}
<div class="col-12 col-lg-6 order-lg-2">
    <div class="row">
        <div class="col-12 col-sm-6">
            <nav aria-label="Pages Clik&amp;Yack" class="nav flex-column" data-test-yack-footer-pages>
                <span class="nav-link fw-bold text-body">Clik&amp;Yack</span>
                {% for cms_page in yack_cms_pages()|filter(p => p.slug != 'accueil') %}
                    <a class="nav-link" href="{{ yack_cms_url(cms_page) }}">{{ cms_page.title }}</a>
                {% endfor %}
                <a class="nav-link" href="{{ path('sylius_shop_contact_request') }}">Nous contacter</a>
            </nav>
        </div>
        <div class="col-12 col-sm-6">
            <nav aria-label="Services" class="nav flex-column mb-5">
                <span class="nav-link fw-bold text-body">Services</span>
                <a class="nav-link" href="{{ path('app_yack_sav_index') }}">SAV &amp; pièces détachées</a>
                <a class="nav-link" href="{{ path('app_yack_installer_index') }}">Trouver un installateur</a>
                <a class="nav-link" href="{{ path('sylius_shop_account_order_index') }}">Suivre mes commandes</a>
            </nav>
        </div>
    </div>
</div>
