{#
    Indicateur de progression Yack (tunnel de commande, inscription).
    steps: [{label, route?, params?}], active_index: étape courante (1-based), links_enabled: liens vers les étapes passées.
#}
<nav class="yack-progress mb-5" aria-label="{{ aria_label|default('Progression') }}">
    <ol class="yack-progress__list">
        {% for step in steps %}
            {% set state = loop.index < active_index ? 'done' : (loop.index == active_index ? 'active' : 'todo') %}
            <li class="yack-progress__step is-{{ state }}" {% if state == 'active' %}aria-current="step"{% endif %} data-test-progress-step="{{ step.name|default(loop.index) }}">
                <span class="yack-progress__bullet">{% if state == 'done' %}✓{% else %}{{ loop.index }}{% endif %}</span>
                {% if state == 'done' and links_enabled|default(true) and step.route|default(null) is not null %}
                    <a class="yack-progress__label" href="{{ path(step.route, step.params|default({})) }}">{{ step.label }}</a>
                {% else %}
                    <span class="yack-progress__label">{{ step.label }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>
