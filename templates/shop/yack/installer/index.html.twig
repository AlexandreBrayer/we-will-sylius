{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Trouver un installateur | {{ parent() }}{% endblock %}

{% block content %}
<div class="container py-5">
    <h1 class="mb-2">Trouver un installateur</h1>
    <p class="text-body-secondary mb-4">Le réseau des installateurs partenaires Yack : installation, entretien et dépannage de vos équipements.</p>

    <form method="get" action="{{ path('app_yack_installer_index') }}" class="row g-3 align-items-end mb-4" data-test-yack-installer-filters>
        <div class="col-md-3">
            <label class="form-label" for="secteur">Secteur</label>
            <select class="form-select" id="secteur" name="secteur" onchange="this.form.requestSubmit()">
                <option value="">Tous les secteurs</option>
                {% for sector in sectors %}
                    <option value="{{ sector }}" {{ criteria.sector == sector ? 'selected' }}>{{ sector }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="gamme">Gamme</label>
            <select class="form-select" id="gamme" name="gamme" onchange="this.form.requestSubmit()">
                <option value="">Toutes les gammes</option>
                {% for range in ranges %}
                    <option value="{{ range }}" {{ criteria.range == range ? 'selected' }}>{{ range }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="activite">Activité</label>
            <select class="form-select" id="activite" name="activite" onchange="this.form.requestSubmit()">
                <option value="">Toutes les activités</option>
                {% for activity in activities %}
                    <option value="{{ activity.value }}" {{ criteria.activity == activity ? 'selected' }}>{{ activity.label() }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Filtrer</button>
            <a class="btn btn-link" href="{{ path('app_yack_installer_index') }}">Réinitialiser</a>
        </div>
    </form>

    <div class="row g-4">
        <div class="col-lg-5 order-lg-2">
            <div class="yack-map rounded-3 border" {{ stimulus_controller('installer-map', {markers: markers}) }}></div>
        </div>
        <div class="col-lg-7">
            <p class="fw-bold" data-test-yack-installer-count="{{ installers|length }}">{{ installers|length }} installateur{{ installers|length > 1 ? 's' : '' }}</p>
            <div class="list-group">
                {% for installer in installers %}
                    <div class="list-group-item py-3" data-test-yack-installer>
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-bold">{{ installer.name }}</div>
                                <div class="small text-body-secondary">{{ installer.postcode }} {{ installer.city }} · {{ installer.sector }}</div>
                            </div>
                            {% if installer.certifiedRge %}<span class="badge text-bg-success">RGE</span>{% endif %}
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            {% for range in installer.ranges %}<span class="badge text-bg-light border">{{ range }}</span>{% endfor %}
                            {% for activity in installer.activities %}<span class="badge text-bg-primary">{{ activity.label() }}</span>{% endfor %}
                        </div>
                        {% if installer.phone %}<div class="small mt-2">Tél. {{ installer.phone }}</div>{% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-light">Aucun installateur ne correspond à ces critères.</div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
